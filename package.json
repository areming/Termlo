{
  "name": "termlo",
  "version": "2.4.1",
  "description": "Local-first SSH, SFTP and server agent desktop client",
  "private": true,
  "main": "src/main.cjs",
  "scripts": {
    "start": "node scripts/start.cjs",
    "build": "node scripts/build.cjs",
    "test": "node --test test/*.test.cjs",
    "test:ui": "node scripts/shell-smoke.cjs",
    "pack": "npm run build && node scripts/pack.cjs",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "dist:mac": "npm run build && electron-builder --mac dmg --publish never"
  },
  "build": {
    "appId": "local.termlo.desktop",
    "productName": "Termlo",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release/2.4.1"
    },
    "files": [
      "src/**/*",
      "dist/**/*",
      "package.json",
      "assets/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/termlo.ico"
    },
    "nsis": {
      "guid": "8347df59-12c1-53a3-a51a-c0ed70289b78",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Termlo-Setup-${version}-${arch}.${ext}"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/termlo.icns",
      "category": "public.app-category.developer-tools",
      "artifactName": "Termlo-${version}-${arch}.${ext}"
    },
    "asar": true,
    "npmRebuild": false
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/xterm": "6.0.0",
    "ssh2": "1.17.0"
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "electron": "44.9.2",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "playwright-core": "1.64.1"
  }
}
